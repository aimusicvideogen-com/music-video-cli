  "homepage": "https://aimusicvideogen.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimusicvideogen-com/music-video-cli.git"
  },
  "bugs": {
    "url": "https://github.com/aimusicvideogen-com/music-video-cli/issues"
  },
  "author": "AIMusicVideoGen <support@aimusicvideogen.com> (https://aimusicvideogen.com)",
  "license": "MIT",
