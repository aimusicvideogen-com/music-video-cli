    "song to video",
    "photo to video",
    "bpm",
    "bpm detection",
    "bpm finder",
    "key detection",
    "tap tempo",
    "spotify canvas",
    "spotify canvas maker",
    "lyric video",
    "suno",
    "udio",
    "musicians",
    "audio analysis",
    "ffmpeg",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude"
